{
  "name": "@ha-plus-matter-hub/root",
  "version": "1.2.7",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "cleanup": "pnpm -r run cleanup && pnpm run cleanup:root",
    "cleanup:root": "npx rimraf node_modules",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "pretest": "pnpm run build:minimum",
    "test": "pnpm -r run test",
    "build": "pnpm -r run build",
    "build:minimum": "pnpm --filter @ha-plus-matter-hub/common run build",
    "build:app": "pnpm --filter './packages/*' run build",
    "preserve": "pnpm run build:minimum",
    "serve": "pnpm -r --parallel run serve",
    "start": "pnpm run serve",
    "preproduction": "pnpm run build:app",
    "production": "pnpm --filter ha-plus-matter-hub run start",
    "check-updates": "npx npm-check-updates --workspaces --root -u",
    "release": "python3 scripts/release.py",
    "release:pack": "pnpm run build:panel && pnpm run build:app && pnpm --filter ha-plus-matter-hub run build",
    "build:panel": "ha-plus-frontend-vendor custom_components/ha_plus_matter_hub/ha_plus_frontend && esbuild src/panel.js --bundle --format=esm --minify-whitespace --target=es2022 --outfile=custom_components/ha_plus_matter_hub/frontend/panel.js && ha-plus-ui-licenses custom_components/ha_plus_matter_hub/frontend",
    "check:panel": "pnpm run build:panel && git diff --exit-code -- custom_components/ha_plus_matter_hub/frontend/panel.js custom_components/ha_plus_matter_hub/ha_plus_frontend"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "docs"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.3.12",
    "@dotenvx/dotenvx": "^1.52.0",
    "@ha-plus/ui": "https://github.com/zvikarp/ha-plus-packages/releases/download/ui-v0.3.4/ha-plus-ui-0.3.4.tgz",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.10",
    "@swc/helpers": "~0.5.18",
    "esbuild": "^0.27.2",
    "esbuild-plugin-noexternal": "^0.1.6",
    "globals": "^17.1.0",
    "nodemon": "^3.1.11",
    "npm-check-updates": "^19.3.1",
    "rimraf": "^6.1.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "@ha-plus/frontend": "https://github.com/zvikarp/ha-plus-packages/releases/download/frontend-v0.1.0/ha-plus-frontend-0.1.0.tgz"
  }
}
